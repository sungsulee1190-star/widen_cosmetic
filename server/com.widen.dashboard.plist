<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  맥미니 로그인 시 WIDEN 서버 자동 실행 (launchd).
  설치: docs/mac-mini-server.md 참고. __REPO__ 와 __NODE__ 는 설치 스크립트가 채운다.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.widen.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/server/server.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key><string>8080</string>
    <key>WIDEN_DATA</key><string>__REPO__/var/work-log.jsonl</string>
    <key>WIDEN_TOKEN</key><string>__TOKEN__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__REPO__/var/server.log</string>
  <key>StandardErrorPath</key><string>__REPO__/var/server.log</string>
</dict>
</plist>
